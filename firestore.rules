rules_version = '2';

// Paste this into the Firebase console: Firestore Database -> Rules -> replace everything -> Publish.
// (Not deployed automatically - Claude can't sign in to your Google account to do that part; see docs/NOTES.md "The
// leaderboard" for the full setup checklist. If you already published an earlier version of this file, you must re-publish
// this one too - it adds the "saves" collection, without which linking an account does nothing but fail silently.)
service cloud.firestore {
  match /databases/{database}/documents {

    // The leaderboard is public to READ (anyone can see the standings, signed in or not) but a player may only ever write
    // THEIR OWN document (uid = their Google account id from Firebase Auth), and only with the shape src/cloud.js writes:
    // { name, coins, character, description, updatedAt }. This is a light sanity check (right size/shape of each field,
    // nobody else's doc, the server's own clock for the timestamp so it can't be backdated or left off) - not a full
    // anti-cheat system. That is the deliberate choice for a 5-person, invite-only group (see docs/NOTES.md); it stops
    // "opened devtools and typed a huge number" without needing a Cloud Function (which would need Firebase's paid plan -
    // see the same notes). `description` is already plain-text-only and length-capped on the client (Economy
    // sanitizeAccountDescription) before it ever gets here - the 400-byte cap below is deliberately looser than that
    // client cap (a short string can still be a few hundred UTF-8 bytes once accented/non-Latin characters are involved),
    // it only exists to block a client that skipped the cleaning entirely.
    // `privateInventory` and `skinCounts` (added 2026-09-29 for the trading feature - see the approved plan and the
    // snowy-balls-blaze-migration memory) are OPTIONAL here on purpose, not required: rules+Functions publish
    // BEFORE the client build that actually sends them (the migration's own standing sequencing rule), so if they
    // were required every write from the OLD, still-live client would start failing the moment these rules go up -
    // exactly the kind of break the snowy-balls-smooth-version-transitions memory exists to prevent. `privateInventory`
    // IS now sent by the client itself (cloud.js syncNow(), 2026-09-30 - a plain preference, not server-owned).
    // `skinCounts` is only ever written by a Cloud Function (Admin SDK, which bypasses these rules entirely)
    // mirroring a player's saves/{uid} totals here - a client never legitimately sends it itself; it's
    // allow-listed here only so a client's own unrelated write (name/coins/character/description) to a doc that
    // already has these fields isn't rejected for containing them. PUBLIC read on this whole doc is what lets the
    // trade-compose "YOU WANT" picker browse a target's real skins (saves.js targetSkinsCatalog) - the ONLY place
    // another player's inventory is ever shown client-side (2026-09-30: the leaderboard inspect popup's own
    // standalone preview was removed).
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['name', 'coins', 'character', 'description', 'updatedAt', 'privateInventory', 'skinCounts'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 60
                   && request.resource.data.coins is number
                   && request.resource.data.coins >= 0
                   && request.resource.data.coins < 100000000000 // 100 billion - no real save gets anywhere near this; it only exists to block a garbage value
                   && (request.resource.data.character == null || (request.resource.data.character is string && request.resource.data.character.size() <= 60))
                   && request.resource.data.description is string
                   && request.resource.data.description.size() <= 400
                   && request.resource.data.updatedAt == request.time // the server's clock, not a value the client can pick
                   && (!('privateInventory' in request.resource.data) || request.resource.data.privateInventory is bool)
                   && (!('skinCounts' in request.resource.data) || request.resource.data.skinCounts is map);
    }

    // The actual cloud save - PRIVATE, unlike the leaderboard: only the owning account can read or write it (nobody else's
    // uid, and no public read - this is not for showing off, it's the save itself). { data: <the whole save, as JSON>,
    // updatedAt, session }. The size cap is generous - a real save is a few KB - and only exists to block a garbage-sized write.
    //
    // read and write are separate rules on purpose (a bug fixed 2026-09-22): `request.resource` is only defined for a
    // WRITE (it's the incoming document being written) - it does not exist on a read, so a single combined
    // `allow read, write: if ... request.resource.data ...` rule fails EVERY read with a rules error, indistinguishable
    // from permission-denied, even once published. That is what was actually breaking Cloud.signIn()'s "does this
    // account already have a save" check - not just an unpublished rules file.
    //
    // `session` (added 2026-09-22): a short random token src/cloud.js writes on every save write, so the same account
    // signed in on two devices at once can't silently overwrite each other - see that file's header comment for the
    // full mechanism. Required on every write (never optional) since the client always sends one from here on.
    // The server-owned economy fields (coins, lifetimeCoins, skinCounts, buffItems, projectiles, buffs, equipped,
    // reserved, outgoingTradeId - see functions/lib/saves.js) only a Cloud Function's Admin SDK write (which
    // bypasses these rules entirely) can ever SET - a client can never grant itself coins or skin counts, only
    // ask a Function to do it. But the CLIENT's own write (cloud.js syncNow(), `{data, updatedAt, session}` with
    // `{merge: true}` as of 2026-09-29) still needs to be ALLOWED once those fields already exist on the doc -
    // Firestore security rules evaluate `request.resource.data` as the FULL RESULTING document after a merge, not
    // just the fields the client sent, so a bare `keys().hasOnly(['data','updatedAt','session'])` would reject
    // every client sync the instant a Cloud Function ever wrote a server-owned field into this same doc (the
    // client's own next write would then contain MORE keys than that allow-list permits, purely by them already
    // being there) - exactly the kind of break the smooth-version-transitions memory exists to prevent. Fixed by
    // allow-listing those fields too, but ONLY if UNCHANGED by this write (`resource` is the doc as it existed
    // BEFORE this request, `null` for a brand-new doc - Firestore's own documented way to tell a create from an
    // update): a client write may include a server-owned field only if its value exactly matches what was already
    // stored, which a legitimate client write never needs to do (cloud.js never sends any of these) and a
    // malicious one attempting to grant itself coins cannot satisfy without already knowing, and merely echoing
    // back, the CURRENT real value - it can never actually change it through this path.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'session', 'coins', 'lifetimeCoins', 'skinCounts', 'buffItems', 'projectiles', 'buffs', 'equipped', 'reserved', 'outgoingTradeId'])
                   && request.resource.data.data is string
                   && request.resource.data.data.size() < 200000
                   && request.resource.data.session is string
                   && request.resource.data.session.size() > 0
                   && request.resource.data.session.size() <= 100
                   && request.resource.data.updatedAt == request.time
                   // A per-field `resource.data.X == request.resource.data.X` comparison (tried first) threw a
                   // genuine evaluation error rather than just failing, for reasons that weren't worth chasing
                   // further once this - Firestore's OWN documented idiom for "which fields did this write
                   // actually change" - turned out simpler and more robust anyway: on an UPDATE,
                   // `.diff(resource.data).affectedKeys()` is the set of keys whose VALUE changed (a field
                   // present and identical on both sides never appears in it at all, regardless of type - no
                   // null/map-equality edge cases to get wrong by hand) - requiring that set to be a subset of
                   // the client-owned fields means a write may add/change `data`/`updatedAt`/`session` freely
                   // but can never actually CHANGE any server-owned field, only (harmlessly) carry its existing
                   // value forward via merge. On a CREATE there is no `resource.data` to diff against at all
                   // (`resource == null` is Firestore's documented way to detect this) - a brand-new doc must
                   // simply not contain any server-owned field yet, checked directly instead.
                   && (resource == null
                        ? request.resource.data.keys().hasOnly(['data', 'updatedAt', 'session'])
                        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt', 'session']));
    }

    // Trade offers (2026-09-29, see the approved plan's Part 3 and functions/trading.js): a client can READ a
    // trade only if it's one of the two participants (never a public list of everyone's offers), and can NEVER
    // write one directly, signed in or not - proposeTrade/acceptTrade/declineTrade/cancelTrade (Cloud Functions,
    // Admin SDK) are the only path that can ever create or change a trades/{tradeId} doc. This is the same
    // separate-read/write-block shape the 2026-09-22 incident established (`request.resource` only exists on a
    // write - `resource` is the existing doc on a read; a combined rule using `request.resource` in a read branch
    // fails every read with an error indistinguishable from "not published yet").
    match /trades/{tradeId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Rate-limit bookkeeping (functions/lib/rateLimit.js) - Admin SDK only, exactly like trades above; a client
    // has no legitimate reason to ever read or write its own rate-limit counters.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // The global shop stock (2026-09-29, plan item 5 - see functions/shop.js/functions/lib/shopStock.js): public
    // to READ, signed in or not, same reasoning as the leaderboard - every client needs to see what's currently
    // on sale to render the SHOP tab at all, and there's nothing private in a rolled stock list. NEVER writable by
    // a client, under any circumstance - only the Cloud Scheduler-triggered rerollShop / the admin-only
    // forceRerollShop (both Admin SDK, bypass these rules entirely) ever touch this doc. This is the actual fix
    // for the multi-tab reroll exploit: one server-generated roll every client reads, instead of each tab
    // computing its own.
    match /shopStock/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Nothing else is stored in Firestore - deny everything else by default, so a later addition here can't accidentally
    // leave something else world-writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
