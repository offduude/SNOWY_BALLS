rules_version = '2';

// Paste this into the Firebase console: Firestore Database -> Rules -> replace everything -> Publish.
// (Not deployed automatically - Claude can't sign in to your Google account to do that part; see docs/NOTES.md "The
// leaderboard" for the full setup checklist. If you already published an earlier version of this file, you must re-publish
// this one too - it adds the "saves" collection, without which linking an account does nothing but fail silently.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite-only allowlist (2026-10-01 - the owner's own ask, after asking whether many botted accounts could
    // overload the project's Firebase limits, then deciding to gate on sign-in + an allowlist rather than rely on
    // Firebase App Check alone, which needs a reCAPTCHA site key the owner doesn't have yet - see
    // functions/lib/auth.js's own matching note and docs/NOTES.md). ANY Google account can still complete a real
    // sign-in (Firebase Auth itself has no concept of "invited"), so this is the actual gate: every rule below
    // that used to be `if true` (public, no sign-in needed at all) or just `request.auth.uid == uid` now also
    // requires the account's own email - straight off the real Google ID token, not anything a client can forge -
    // to be on this list. The game was never meant to support a never-signed-in local play mode, so nothing here
    // stays public. Mirrored by hand in functions/lib/auth.js's ALLOWED_EMAILS (rules can't require() that file) -
    // keep the two lists in sync manually, same as ADMIN_UID already is across multiple files in this project.
    function isAllowedEmail() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() in [
        'joatre2741@gmail.com',
        't4backupemail2@gmail.com',
        'domimarzec111@gmail.com',
        'kubamolo592@gmail.com',
        'offduude@gmail.com',
        'snowyballs759@gmail.com'
      ];
    }

    // The leaderboard - readable only by an allowed account (2026-10-01, was public to everyone - see
    // isAllowedEmail's own note above) - but a player may only ever write
    // THEIR OWN document (uid = their Google account id from Firebase Auth), and only with the shape src/cloud.js writes:
    // { name, coins, character, description, updatedAt }. This is a light sanity check (right size/shape of each field,
    // nobody else's doc, the server's own clock for the timestamp so it can't be backdated or left off) - not a full
    // anti-cheat system. That is the deliberate choice for a 5-person, invite-only group (see docs/NOTES.md); it stops
    // "opened devtools and typed a huge number" without needing a Cloud Function (which would need Firebase's paid plan -
    // see the same notes). `description` is already plain-text-only and length-capped on the client (Economy
    // sanitizeAccountDescription) before it ever gets here - the 400-byte cap below is deliberately looser than that
    // client cap (a short string can still be a few hundred UTF-8 bytes once accented/non-Latin characters are involved),
    // it only exists to block a client that skipped the cleaning entirely.
    // `privateInventory` (added 2026-09-29 for the trading feature - see the approved plan and the
    // snowy-balls-blaze-migration memory) is OPTIONAL here on purpose, not required: rules+Functions publish
    // BEFORE the client build that actually sends them (the migration's own standing sequencing rule), so if it
    // were required every write from the OLD, still-live client would start failing the moment these rules go up -
    // exactly the kind of break the snowy-balls-smooth-version-transitions memory exists to prevent. It IS now sent
    // by the client itself (cloud.js syncNow(), 2026-09-30 - a plain preference, not server-owned).
    // `skinCounts` USED to live here too, mirrored by a Cloud Function - moved OUT entirely to its own
    // inventoryMirror/{uid} collection below (2026-10-01, the owner's own question: "can we even make it that a
    // modified client cannot read the private inventory?"). Firestore rules have no notion of "public except this
    // one field" - skinCounts riding on the same PUBLIC-READ document as the leaderboard listing meant a private
    // player's real inventory was always readable by anyone willing to read this doc directly, no matter how
    // convincingly the client's own TRADE button hid it. See inventoryMirrorRef's own note (functions/lib/
    // saves.js) and functions/trading.js getTargetInventory for the real, server-enforced replacement.
    match /leaderboard/{uid} {
      allow read: if isAllowedEmail();
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isAllowedEmail()
                   && request.resource.data.keys().hasOnly(['name', 'coins', 'character', 'description', 'updatedAt', 'privateInventory'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 60
                   // `coins` (made OPTIONAL here 2026-10-01, a real bug found live-testing the private-inventory
                   // fix): the client stopped sending this field entirely weeks ago (syncNow() - only a Cloud
                   // Function mirrors it now), so a genuinely brand-new account's first-ever client write (name/
                   // description/privateInventory - e.g. the owner's own repro, toggling OPTIONS before ever
                   // throwing a snowball) hits a doc with no `coins` field at all yet, and `request.resource.data
                   // .coins is number` on a key that plain doesn't exist throws an evaluation error instead of
                   // just failing - silently blocking that player's very first sync of anything, forever, until
                   // some OTHER action finally gets a Cloud Function to create the doc first. Same optional
                   // pattern `character`/`privateInventory`/`skinCounts` already use below; still validated
                   // whenever it IS present (whether carried forward from an existing Cloud Function write, or
                   // this write's own merge of one).
                   && (!('coins' in request.resource.data) || (request.resource.data.coins is number && request.resource.data.coins >= 0 && request.resource.data.coins < 100000000000)) // 100 billion - no real save gets anywhere near this; it only exists to block a garbage value
                   && (request.resource.data.character == null || (request.resource.data.character is string && request.resource.data.character.size() <= 60))
                   && request.resource.data.description is string
                   && request.resource.data.description.size() <= 400
                   && request.resource.data.updatedAt == request.time // the server's clock, not a value the client can pick
                   && (!('privateInventory' in request.resource.data) || request.resource.data.privateInventory is bool);
    }

    // A player's real skin counts (2026-10-01) - split OUT of leaderboard/{uid} specifically so it is NEVER
    // public-read, unlike that document. `allow read, write: if false` - Admin SDK only, same as trades/
    // rateLimits below; the ONLY way any client ever learns a skinCounts value (their own or someone else's) is
    // functions/trading.js getTargetInventory, which checks the TARGET's own privateInventory flag (on
    // leaderboard/{uid}) before ever returning anything. See inventoryMirrorRef's own note, functions/lib/saves.js.
    match /inventoryMirror/{uid} {
      allow read, write: if false;
    }

    // The actual cloud save - PRIVATE, unlike the leaderboard: only the owning account can read or write it (nobody else's
    // uid, and no public read - this is not for showing off, it's the save itself). { data: <the whole save, as JSON>,
    // updatedAt, session }. The size cap is generous - a real save is a few KB - and only exists to block a garbage-sized write.
    //
    // read and write are separate rules on purpose (a bug fixed 2026-09-22): `request.resource` is only defined for a
    // WRITE (it's the incoming document being written) - it does not exist on a read, so a single combined
    // `allow read, write: if ... request.resource.data ...` rule fails EVERY read with a rules error, indistinguishable
    // from permission-denied, even once published. That is what was actually breaking Cloud.signIn()'s "does this
    // account already have a save" check - not just an unpublished rules file.
    //
    // `session` (added 2026-09-22): a short random token src/cloud.js writes on every save write, so the same account
    // signed in on two devices at once can't silently overwrite each other - see that file's header comment for the
    // full mechanism. Required on every write (never optional) since the client always sends one from here on.
    // The server-owned economy fields (coins, lifetimeCoins, skinCounts, buffItems, projectiles, buffs, equipped,
    // reserved, outgoingTradeId - see functions/lib/saves.js) only a Cloud Function's Admin SDK write (which
    // bypasses these rules entirely) can ever SET - a client can never grant itself coins or skin counts, only
    // ask a Function to do it. But the CLIENT's own write (cloud.js syncNow(), `{data, updatedAt, session}` with
    // `{merge: true}` as of 2026-09-29) still needs to be ALLOWED once those fields already exist on the doc -
    // Firestore security rules evaluate `request.resource.data` as the FULL RESULTING document after a merge, not
    // just the fields the client sent, so a bare `keys().hasOnly(['data','updatedAt','session'])` would reject
    // every client sync the instant a Cloud Function ever wrote a server-owned field into this same doc (the
    // client's own next write would then contain MORE keys than that allow-list permits, purely by them already
    // being there) - exactly the kind of break the smooth-version-transitions memory exists to prevent. Fixed by
    // allow-listing those fields too, but ONLY if UNCHANGED by this write (`resource` is the doc as it existed
    // BEFORE this request, `null` for a brand-new doc - Firestore's own documented way to tell a create from an
    // update): a client write may include a server-owned field only if its value exactly matches what was already
    // stored, which a legitimate client write never needs to do (cloud.js never sends any of these) and a
    // malicious one attempting to grant itself coins cannot satisfy without already knowing, and merely echoing
    // back, the CURRENT real value - it can never actually change it through this path.
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && isAllowedEmail();
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isAllowedEmail()
                   && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'session', 'coins', 'lifetimeCoins', 'skinCounts', 'buffItems', 'projectiles', 'buffs', 'equipped', 'reserved', 'outgoingTradeId', 'personalShopStock', 'shopBought'])
                   && request.resource.data.data is string
                   && request.resource.data.data.size() < 200000
                   && request.resource.data.session is string
                   && request.resource.data.session.size() > 0
                   && request.resource.data.session.size() <= 100
                   && request.resource.data.updatedAt == request.time
                   // FIX (2026-10-01, a real bug live-tested against the emulator - see docs/NOTES.md): the
                   // `.diff(resource.data).affectedKeys().hasOnly([...])` idiom this used to use does NOT keep its
                   // own documented promise that "a field present and identical on both sides never appears in it
                   // at all" - `personalShopStock`/`shopBought` (nested-map server-owned fields, unlike the
                   // flatter ones that happened to be exercised when this was first written) showed up in
                   // `affectedKeys()` even completely UNCHANGED, rejecting every real player's sync the moment a
                   // Cloud Function ever wrote either field - which is every player, from their very first shop
                   // purchase. Confirmed live: `.get(key, null)` equality per field does NOT have this problem.
                   // On a CREATE there is no `resource.data` to compare against at all (`resource == null` is
                   // Firestore's documented way to detect this) - a brand-new doc must simply not contain any
                   // server-owned field yet, checked directly instead. On an UPDATE, each server-owned field (see
                   // functions/lib/saves.js SERVER_OWNED_FIELDS - keep this list in sync with that one) must carry
                   // forward UNCHANGED; `.get(key, null)` compares safely whether or not the key exists on either
                   // side, so a field genuinely absent from both, or present and equal on both, always passes.
                   && (resource == null
                        ? request.resource.data.keys().hasOnly(['data', 'updatedAt', 'session'])
                        : request.resource.data.get('coins', null) == resource.data.get('coins', null)
                          && request.resource.data.get('lifetimeCoins', null) == resource.data.get('lifetimeCoins', null)
                          && request.resource.data.get('skinCounts', null) == resource.data.get('skinCounts', null)
                          && request.resource.data.get('buffItems', null) == resource.data.get('buffItems', null)
                          && request.resource.data.get('projectiles', null) == resource.data.get('projectiles', null)
                          && request.resource.data.get('buffs', null) == resource.data.get('buffs', null)
                          && request.resource.data.get('equipped', null) == resource.data.get('equipped', null)
                          && request.resource.data.get('reserved', null) == resource.data.get('reserved', null)
                          && request.resource.data.get('outgoingTradeId', null) == resource.data.get('outgoingTradeId', null)
                          && request.resource.data.get('personalShopStock', null) == resource.data.get('personalShopStock', null)
                          && request.resource.data.get('shopBought', null) == resource.data.get('shopBought', null));
    }

    // Trade offers (2026-09-29, see the approved plan's Part 3 and functions/trading.js): a client can READ a
    // trade only if it's one of the two participants (never a public list of everyone's offers), and can NEVER
    // write one directly, signed in or not - proposeTrade/acceptTrade/declineTrade/cancelTrade (Cloud Functions,
    // Admin SDK) are the only path that can ever create or change a trades/{tradeId} doc. This is the same
    // separate-read/write-block shape the 2026-09-22 incident established (`request.resource` only exists on a
    // write - `resource` is the existing doc on a read; a combined rule using `request.resource` in a read branch
    // fails every read with an error indistinguishable from "not published yet").
    match /trades/{tradeId} {
      allow read: if request.auth != null
                  && isAllowedEmail()
                  && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Rate-limit bookkeeping (functions/lib/rateLimit.js) - Admin SDK only, exactly like trades above; a client
    // has no legitimate reason to ever read or write its own rate-limit counters.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // The global shop stock (2026-09-29, plan item 5 - see functions/shop.js/functions/lib/shopStock.js): readable
    // only by an allowed account (2026-10-01, was public - see isAllowedEmail's own note above; this game was
    // never meant to support a never-signed-in local play mode, so there's no reason to keep this public). NEVER
    // writable by a client, under any circumstance - only the Cloud Scheduler-triggered rerollShop / the admin-only
    // forceRerollShop (both Admin SDK, bypass these rules entirely) ever touch this doc. This is the actual fix
    // for the multi-tab reroll exploit: one server-generated roll every client reads, instead of each tab
    // computing its own.
    match /shopStock/{docId} {
      allow read: if isAllowedEmail();
      allow write: if false;
    }

    // Version-gate config (2026-09-30 - see functions/lib/version.js). Readable only by an allowed account
    // (2026-10-01, was public - same reasoning as shopStock above): every client needs to read config/minVersion
    // itself for the proactive "am I already stale" check (src/cloud.js checkClientVersion), not just find out
    // reactively when a Function rejects a call - but a non-allowed account was never going to get past
    // requireAuth anyway, so there's nothing lost by gating the proactive check the same way as everything else.
    // NEVER writable by a client - only ever hand-set via the Firestore console (matching this project's existing
    // discipline of hand-pasting rules rather than automating deploys), read by every callable Function via the
    // Admin SDK, which bypasses these rules entirely.
    match /config/{docId} {
      allow read: if isAllowedEmail();
      allow write: if false;
    }

    // Nothing else is stored in Firestore - deny everything else by default, so a later addition here can't accidentally
    // leave something else world-writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
